@startuml
title Tetris - Final UML Class Diagram

skinparam classAttributeIconSize 0

package "org.example.model" {

interface Movable {
    + moveLeft() : void
    + moveRight() : void
    + moveDown() : void
    + rotate() : void
}

abstract class GamePiece {
    + {static} CELL_SIZE : int
    # column : int
    # row : int

    + GamePiece(column : int, row : int)
    + setGridPosition(column : int, row : int) : void
    + moveLeft() : void
    + moveRight() : void
    + moveDown() : void
    + getColumn() : int
    + getRow() : int
    + getCells() : Position[]
}

class Tetromino {
    - type : Type
    - rotation : int
    - {static} SHAPES : int[][][][]

    + Tetromino(type : Type)
    + getCells() : Position[]
    + getColor() : Color
    + rotate() : void
    + rotateBack() : void
    + getType() : Type
}

enum Type {
    I
    O
    T
    S
    Z
    J
    L
}

class Position <<record>> {
    + column : int
    + row : int
}

class GameBoard {
    - {static} ROWS : int
    - {static} COLUMNS : int
    - {static} CELL_SIZE : int
    - currentPiece : Tetromino
    - gameLoop : Timeline
    - paused : boolean
    - gameOver : boolean
    - animationRunning : boolean
    - score : int
    - lines : int
    - level : int

    + GameBoard()
    + moveLeft() : void
    + moveRight() : void
    + softDrop() : void
    + rotatePiece() : void
    + hardDrop() : void
    + togglePause() : void
    + restartGame() : void
}

}

package "org.example.controller" {

class GameController {
    - gameBoard : GameBoard

    + GameController(gameBoard : GameBoard)
    + moveLeft() : void
    + moveRight() : void
    + softDrop() : void
    + rotatePiece() : void
    + hardDrop() : void
    + restartGame() : void
    + togglePause() : void
}

}

package "org.example.view" {

class TetrisApplication {
    - stage : Stage
    - mainMenuScene : Scene

    + start(stage : Stage) : void
    + {static} main(args : String[]) : void
}

}

Movable <|.. GamePiece : implements
GamePiece <|-- Tetromino : extends

Tetromino --> Type : has type
Tetromino --> Position : uses
GameBoard *-- Tetromino : current piece
GameController --> GameBoard : controls
TetrisApplication --> GameBoard : creates

note right of GameBoard
Extends JavaFX BorderPane
end note

note right of GamePiece
Extends JavaFX Group
end note

note right of TetrisApplication
Extends JavaFX Application
end note

@enduml